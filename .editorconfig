root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,mjs}]
indent_style = space
indent_size = 4

[*.{json,webmanifest}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{xml,svg}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 4

[*.txt]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf

[*.{png,jpg,jpeg,gif,webp,avif,ico,woff,woff2,pdf,zip}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
